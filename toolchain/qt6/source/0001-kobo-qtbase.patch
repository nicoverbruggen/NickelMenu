Subject: [PATCH] Reproduce Kobo's Qt 6.5.2 qtbase changes

Extracted from kobolabs/Kobo-Reader commit
7a762964e7fa71ad8e8df50dd1b6eee721a43217, packages-v5.
Base: official qtbase-everywhere-src-6.5.2.tar.xz.
Includes changes carried by Kobo; this is not an attribution of authorship.
Upstream-Status: Inappropriate [Kobo firmware source compatibility]

diff --git a/.tag b/.tag
index 1af39ca..76d8daf 100644
--- a/.tag
+++ b/.tag
@@ -1 +1 @@
-af457a9f0f7eb1a2a7d11f495da508faab91a442
+d03daaeed4400b3e3804cf971400ee4ffdaf409b
diff --git a/cmake/qt.toolchain.cmake.in b/cmake/qt.toolchain.cmake.in
index 15cf7a4..03de928 100644
--- a/cmake/qt.toolchain.cmake.in
+++ b/cmake/qt.toolchain.cmake.in
@@ -67,8 +67,8 @@ get_filename_component(QT_TOOLCHAIN_RELOCATABLE_CMAKE_DIR "${CMAKE_CURRENT_LIST_
 # Instead of collapsing the search prefix (which is the case when one is a subdir of the other),
 # it concatenates them creating an invalid path. Workaround it by setting the root path to the
 # Qt install prefix, and the prefix path to the lib/cmake subdir.
-list(PREPEND CMAKE_PREFIX_PATH "${QT_TOOLCHAIN_RELOCATABLE_CMAKE_DIR}")
-list(PREPEND CMAKE_FIND_ROOT_PATH "${QT_TOOLCHAIN_RELOCATABLE_INSTALL_PREFIX}")
+#list(PREPEND CMAKE_PREFIX_PATH "${QT_TOOLCHAIN_RELOCATABLE_CMAKE_DIR}")
+#list(PREPEND CMAKE_FIND_ROOT_PATH "${QT_TOOLCHAIN_RELOCATABLE_INSTALL_PREFIX}")
 
 # Let CMake load our custom platform modules.
 # CMake-provided platform modules take precedence.
diff --git b/mkspecs/common/linux-kobo.conf b/mkspecs/common/linux-kobo.conf
new file mode 100644
index 0000000..e826a1a
--- /dev/null
+++ b/mkspecs/common/linux-kobo.conf
@@ -0,0 +1,9 @@
+QMAKE_CXXFLAGS += -std=c++17
+QMAKE_LFLAGS += -std=c++17
+QMAKE_OBJCXXFLAGS_PRECOMPILE += -std=c++17
+
+INCLUDEPATH += $$(KOBO_BUILD_DIR)/icu/icu4c/source/common $$(KOBO_BUILD_DIR)/icu/icu4c/source/i18n
+QMAKE_LIBS = -L$$(KOBO_BUILD_DIR)/icu4c-x86/lib
+
+QT_LFLAGS_SQLITE = -lsqlcipher -lcrypto -lz
+QT_CFLAGS_SQLITE = -I/usr/include/sqlcipher
