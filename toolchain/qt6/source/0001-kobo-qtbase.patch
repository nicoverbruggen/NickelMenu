diff --git b/mkspecs/linux-armv7-fusion-g++/qmake.conf b/mkspecs/linux-armv7-fusion-g++/qmake.conf
new file mode 100644
index 0000000..d88c9ac
--- /dev/null
+++ b/mkspecs/linux-armv7-fusion-g++/qmake.conf
@@ -0,0 +1,52 @@
+#
+# Kobo qmake configuration
+#
+
+MAKEFILE_GENERATOR      = UNIX
+CONFIG                 += incremental gdb_dwarf_index
+QMAKE_INCREMENTAL_STYLE = sublib
+
+include(../common/linux.conf)
+include(../common/gcc-base-unix.conf)
+include(../common/g++-unix.conf)
+
+#QMAKE_CFLAGS_RELEASE   = -O3 -march=armv7-a -mfpu=neon -mfloat-abi=hard -D__arm__ -D__ARM_NEON__ -fPIC -fno-omit-frame-pointer -funwind-tables -Wl,--no-merge-exidx-entries
+QMAKE_CFLAGS_RELEASE_WITH_DEBUGINFO = $$QMAKE_CFLAGS_RELEASE_WITH_DEBUGINFO -g
+QMAKE_CFLAGS                += $$(OE_QMAKE_CFLAGS)
+QMAKE_CXXFLAGS              += $$(OE_QMAKE_CXXFLAGS) -Wno-unused-parameter
+QMAKE_LFLAGS                += $$(OE_QMAKE_LDFLAGS)
+
+QMAKE_CXXFLAGS_RELEASE = $$QMAKE_CFLAGS_RELEASE -std=c++17
+QMAKE_CXXFLAGS_RELEASE_WITH_DEBUGINFO = $$QMAKE_CFLAGS_RELEASE_WITH_DEBUGINFO -stdlib=libc++ -std=c++17
+
+# tc settings from g++-base.conf
+QMAKE_CC       = $$(OE_QMAKE_CC)
+QMAKE_CXX      = $$(OE_QMAKE_CXX)
+QMAKE_LINK         = $$(OE_QMAKE_LINK)
+QMAKE_LINK_SHLIB   = $$(OE_QMAKE_LINK)
+QMAKE_AR_LTCG      = $$(OE_QMAKE_AR_LTCG) cqs
+#
+## modifications to linux.conf
+#QMAKE_NM                = arm-fslc-linux-gnueabi-gcc-nm -P
+QMAKE_AR              = $$(OE_QMAKE_AR) cqs
+QMAKE_STRIP           = $$(OE_QMAKE_STRIP)
+QMAKE_OBJCOPY         = $$(OE_QMAKE_OBJCOPY)
+
+QMAKE_LFLAGS_SHLIB += -Wl,-z,relro -Wl,-z,now
+QMAKE_LINK_C       = $$(OE_QMAKE_LINK)
+QMAKE_LINK_C_SHLIB = $$(OE_QMAKE_LINK)
+
+include(../oe-device-extra.pri)
+
+load(device_config)
+load(qt_config)
+count(QMAKE_AR, 1): QMAKE_AR = $$[QT_HOST_PREFIX]/usr/bin/arm-fslc-linux-gnueabi/arm-fslc-linux-gnueabi-gcc-ar cqs
+count(QMAKE_AR_LTCG, 1): QMAKE_AR_LTCG = $$[QT_HOST_PREFIX]/usr/bin/arm-fslc-linux-gnueabi/arm-fslc-linux-gnueabi-gcc-ar cqs
+isEmpty(QMAKE_STRIP): QMAKE_STRIP = $$[QT_HOST_PREFIX]/usr/bin/arm-fslc-linux-gnueabi/arm-fslc-linux-gnueabi-strip
+isEmpty(QMAKE_OBJCOPY): QMAKE_OBJCOPY = $$[QT_HOST_PREFIX]/usr/bin/arm-fslc-linux-gnueabi/arm-fslc-linux-gnueabi-objcopy
+isEmpty(QMAKE_CC): QMAKE_CC = $$[QT_HOST_PREFIX]/usr/bin/arm-fslc-linux-gnueabi/arm-fslc-linux-gnueabi-gcc  -mthumb -mfpu=neon -mfloat-abi=hard -mcpu=cortex-a9  --sysroot=$$[QT_SYSROOT]
+isEmpty(QMAKE_CFLAGS): QMAKE_CFLAGS =   -O2 -pipe -g -feliminate-unused-debug-types 
+isEmpty(QMAKE_CXX): QMAKE_CXX = $$[QT_HOST_PREFIX]/usr/bin/arm-fslc-linux-gnueabi/arm-fslc-linux-gnueabi-g++  -mthumb -mfpu=neon -mfloat-abi=hard -mcpu=cortex-a9  --sysroot=$$[QT_SYSROOT]
+isEmpty(QMAKE_CXXFLAGS): QMAKE_CXXFLAGS =   -O2 -pipe -g -feliminate-unused-debug-types  -fvisibility-inlines-hidden
+isEmpty(QMAKE_LINK): QMAKE_LINK = $$[QT_HOST_PREFIX]/usr/bin/arm-fslc-linux-gnueabi/arm-fslc-linux-gnueabi-g++  -mthumb -mfpu=neon -mfloat-abi=hard -mcpu=cortex-a9  --sysroot=$$[QT_SYSROOT]
+isEmpty(QMAKE_LFLAGS): QMAKE_LFLAGS = -Wl,-O1 -Wl,--hash-style=gnu -Wl,--as-needed  -Wl,-z,relro,-z,now 
